# Deployment-local values. Copy to .env; never commit the real file.
# Compose mounts this common parent once, preserving hard links and mount identity.
PICSYNC_PHOTO_ROOT=/srv/photos
PICSYNC_SOURCE_SUBDIR=source
PICSYNC_TARGET_SUBDIR=target
# Expected filesystem type: change to nfs4, xfs, btrfs, etc. to match the media mount.
PICSYNC_MEDIA_FS=ext4
PICSYNC_SERIAL=
# Full paired Syncthing device ID, or its first group. Never use a real ID here.
PICSYNC_SYNCTHING_DEVICE=
PICSYNC_MYSQL_HOST=127.0.0.1
PICSYNC_MYSQL_PORT=3306
PICSYNC_MYSQL_USER=picsync
PICSYNC_MYSQL_PASSWORD=
PICSYNC_MYSQL_DATABASE=picsync
PICSYNC_DASHBOARD_MYSQL_USER=picsync_reader
PICSYNC_DASHBOARD_MYSQL_PASSWORD=
PICSYNC_BARK_KEY=
# Empty URLs hide the respective dashboard shortcut. No credentials in URLs.
PICSYNC_PIXEL_URL=
PICSYNC_SYNCTHING_URL=
PICSYNC_UID=1000
PICSYNC_GID=1000
TZ=Asia/Shanghai
PIXEL_WEB_PORT=8001
SYNCTHING_IMAGE=syncthing/syncthing:latest
PIXEL_IMAGE=ghcr.io/bilbospocketses/ws-scrcpy-web:stable
# Used only with the optional database profile. Set a strong password first.
MYSQL_ROOT_PASSWORD=
